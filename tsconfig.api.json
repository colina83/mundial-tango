{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "api/**/*.ts",
    "server/**/*.ts",
    "tests/picks/**/*.ts",
    "scripts/predict-top3.ts",
    "scripts/predict-top3.test.ts",
    "scripts/generate-seo.ts",
    "scripts/generate-seo.test.ts",
    "src/lib/picks.ts",
    "src/types.ts"
  ]
}
