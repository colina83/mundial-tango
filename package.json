{
  "name": "mundial-tango",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Unofficial fan tracker for Tango BA Mundial de Baile 2026 results. Source: Tango BA. Not affiliated.",
  "homepage": "https://pulso-mundial-tango.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/colina83/mundial-tango.git"
  },
  "keywords": [
    "tango",
    "mundial-de-tango",
    "tango-ba",
    "tango-results",
    "resultados-tango"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "setup": "npm install && npm run ingest:offline && npm run ingest:historic",
    "start": "vite preview",
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.api.json && vite build && tsx scripts/generate-seo.ts",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "tsx --test scripts/pdf-highlight.test.ts scripts/ingest.test.ts scripts/parse-highlight.test.ts scripts/predict-top3.test.ts scripts/generate-seo.test.ts tests/picks/*.test.ts",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:offline": "tsx scripts/ingest.ts --offline",
    "ingest:historic": "tsx scripts/ingest-historic.ts",
    "ingest:overall": "tsx scripts/overall.ts",
    "survival": "tsx scripts/survival.ts",
    "predict:top3": "tsx scripts/predict-top3.ts",
    "seo:generate": "tsx scripts/generate-seo.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.3",
    "@vercel/analytics": "^2.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "unpdf": "^1.8.1",
    "vite": "^8.2.2"
  }
}
